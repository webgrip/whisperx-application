# GPU worker built on a public WhisperX container image.
# This keeps WhisperX + pyannote dependency details out of our codebase.
FROM ghcr.io/jim60105/whisperx:no_model

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# The base image includes a venv at /venv but does not ship with pip installed.
# Put venv scripts on PATH so `rq` is available at runtime.
ENV PATH="/venv/bin:$PATH"

# Ensure runtime tools are present (ffprobe is required for chunking; ffmpeg helps decode inputs).
# The upstream image runs as a non-root user, so we temporarily switch to root to install OS packages.
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
USER 1001

WORKDIR /app
COPY pyproject.toml requirements.worker.txt /app/
COPY offline_whisperx /app/offline_whisperx

RUN /venv/bin/python -m ensurepip --upgrade --default-pip \
 && /venv/bin/python -m pip install -U pip \
 && /venv/bin/python -m pip install --no-cache-dir -r requirements.worker.txt

# The upstream image's ENTRYPOINT is `whisperx`, which breaks our worker command
# (we need to run `rq worker ...`). Clear it so docker-compose `command:` works.
ENTRYPOINT []

# Default command is overridden by docker-compose to start rq worker.
CMD ["python", "-c", "print('worker image built; override CMD in compose')"]
