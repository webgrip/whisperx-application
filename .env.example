# Copy this file to .env and adjust values.
#
# NOTE: .env is read by offline_whisperx/settings.py (pydantic-settings) and can also be used
# for `docker compose` env interpolation if you choose. This repo's Docker build ignores .env.

# ---- Hugging Face cache (bind-mounted via docker-compose.yml) ----
HF_HOME=/.cache/huggingface
HF_HUB_CACHE=/.cache/huggingface/hub
WHISPERX_MODEL_DIR=/.cache
PYANNOTE_CACHE=/.cache/pyannote

# If you need to download gated models (e.g., pyannote) on an online machine:
# (Not required at runtime if you already staged the weights locally.)
HF_TOKEN=hf_your_token_here

# ---- Queue ----
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=whisperx

# ---- WhisperX CLI settings ----
# These match the upstream WhisperX CLI flags.
WHISPER_MODEL=large-v2
# Optional override (otherwise WhisperX auto-picks based on language)
# ALIGN_MODEL=WAV2VEC2_ASR_LARGE_LV60K_960H
# Optional override for diarization pipeline
# DIARIZE_MODEL=pyannote/speaker-diarization-3.1

# ---- Runtime ----
# API should typically stay CPU; worker should typically be cuda.
DEVICE=auto
COMPUTE_TYPE=auto
LANGUAGE=

# ---- Service layout ----
OUTDIR=/app/output
UPLOADS_DIR=/app/data/uploads
JOBS_DIR=/app/output/jobs

# ---- Defaults (optional; API also exposes query params) ----
DO_ALIGN=true
DO_DIARIZE=false
