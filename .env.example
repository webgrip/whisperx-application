# Copy this file to .env and adjust values.
#
# NOTE: .env is read by offline_whisperx/settings.py (pydantic-settings) and can also be used
# for `docker compose` env interpolation if you choose. This repo's Docker build ignores .env.

# ---- Offline enforcement ----
OFFLINE_WHISPERX_ENFORCE_OFFLINE=1

# ---- Hugging Face cache (bind-mounted via docker-compose.yml) ----
HF_HOME=/app/models/hf_cache
HF_HUB_CACHE=/app/models/hf_cache

# If you need to download gated models (e.g., pyannote) on an online machine:
# (Not required at runtime if you already staged the weights locally.)
HF_TOKEN=hf_your_token_here

# ---- Queue ----
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=whisperx

# ---- Model paths (inside container) ----
# Point these at the directories created by the prefetch scripts under ./models
WHISPER_MODEL=/app/models/faster-whisper-small
ALIGN_MODEL=/app/models/wav2vec2-base-960h
PYANNOTE_CONFIG=/app/config/pyannote_diarization_config.yaml

# ---- Runtime ----
# API should typically stay CPU; worker should typically be cuda.
DEVICE=auto
COMPUTE_TYPE=auto
LANGUAGE=

# ---- Service layout ----
OUTDIR=/app/output
UPLOADS_DIR=/app/data/uploads
JOBS_DIR=/app/output/jobs

# ---- Defaults (optional; API also exposes query params) ----
DO_ALIGN=true
DO_DIARIZE=false
